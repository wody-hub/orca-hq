@@ -0,0 +1,79 @@
+import { useEffect, useId, useRef, useState, type ReactNode } from "react";
+import { OperationsApiError, type OperationsApi, type OperationsMutationReceipt } from "../api.js";
+
+function newRequestId(): string {
+  return `request_${crypto.randomUUID()}`;
+}
+
+export function ReviewedMutation({ label, title, review, disabled = false, execute, onConflict }: Readonly<{
+  api: OperationsApi;
+  label: string;
+  title: string;
+  review: ReactNode;
+  disabled?: boolean;
+  execute(requestId: string): Promise<OperationsMutationReceipt>;
+  onConflict?: () => void;
+}>) {
+  const headingId = useId();
+  const requestId = useRef(newRequestId());
+  const trigger = useRef<HTMLButtonElement>(null);
+  const confirm = useRef<HTMLButtonElement>(null);
+  const [open, setOpen] = useState(false);
+  const [submitting, setSubmitting] = useState(false);
+  const [receipt, setReceipt] = useState<OperationsMutationReceipt>();
+  const close = () => { setOpen(false); queueMicrotask(() => trigger.current?.focus()); };
+  useEffect(() => {
+    if (!open) return;
+    confirm.current?.focus();
+    const keydown = (event: KeyboardEvent) => {
+      if (event.key === "Escape" && !submitting) { event.preventDefault(); close(); }
+    };
+    document.addEventListener("keydown", keydown);
+    return () => document.removeEventListener("keydown", keydown);
+  }, [open, submitting]);
+  const submit = async () => {
+    if (submitting || receipt) return;
+    setSubmitting(true);
+    try {
+      const next = await execute(requestId.current);
+      setReceipt(next);
+      if (next.state === "rejected") onConflict?.();
+    } catch (error) {
+      const rejected = error instanceof OperationsApiError && error.status === 409;
+      setReceipt({ requestId: requestId.current, action: "unconfirmed", targetId: requestId.current, state: rejected ? "rejected" : "unknown", observedAt: new Date().toISOString(), detail: error instanceof OperationsApiError ? error.code : "network_error" });
+      if (rejected) onConflict?.();
+    } finally { setSubmitting(false); setOpen(false); }
+  };
+  return <div className="reviewed-mutation">
+    <button ref={trigger} type="button" disabled={disabled || !!receipt} onClick={() => setOpen(true)}>{label}</button>
+    {receipt?.state === "accepted" ? <p className="mutation-result accepted" role="status">접수되었지만 완료된 것은 아닙니다. 이후 권위 있는 상태 관찰로 완료를 확인하세요.</p> : null}
