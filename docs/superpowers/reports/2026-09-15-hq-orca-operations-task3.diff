+import { useState } from "react";
+import type { HqContext, OperationsApi, OrcaWorkerPage } from "../api.js";
+import { AsyncState } from "../components/async-state.js";
+import { SourceBadge } from "../components/source-badge.js";
+import { useVisiblePolling } from "../hooks.js";
+
+type Worker = OrcaWorkerPage["workers"][number];
+export function OperationsList({ api, navigate }: Readonly<{ api: OperationsApi; navigate: (path: string) => void }>) {
+  const [filter, setFilter] = useState<"all" | "hq" | "orca">("all");
+  const [moreContexts, setMoreContexts] = useState<readonly HqContext[]>([]);
+  const [moreWorkers, setMoreWorkers] = useState<readonly Worker[]>([]);
+  const [contextCursor, setContextCursor] = useState<string>();
+  const [workerCursor, setWorkerCursor] = useState<string>();
+  const read = useVisiblePolling(async (signal) => {
+    const [contexts, workers, runs] = await Promise.all([api.contexts(undefined, signal), api.workers(undefined, signal), api.runs(undefined, signal)]);
+    setContextCursor(contexts.cursor); setWorkerCursor(workers.page.nextCursor ?? undefined);
+    return { contexts, workers, runs };
+  }, 5000, [api]);
+  if (!read.data || read.state !== "ready") return <AsyncState state={read.state} onRetry={read.reload} />;
+  const contexts = [...read.data.contexts.contexts, ...moreContexts].filter((row, index, all) => all.findIndex((candidate) => candidate.contextId === row.contextId) === index);
+  const workers = [...read.data.workers.workers, ...moreWorkers].filter((row, index, all) => all.findIndex((candidate) => candidate.dispatchId === row.dispatchId) === index);
+  const loadMore = async () => {
+    if (filter !== "orca" && contextCursor) { const page = await api.contexts(contextCursor); if (page.cursor !== contextCursor) { setMoreContexts((value) => [...value, ...page.contexts]); setContextCursor(page.cursor); } else setContextCursor(undefined); }
+    if (filter !== "hq" && workerCursor) { const page = await api.workers(workerCursor); const next = page.page.nextCursor ?? undefined; if (next !== workerCursor) { setMoreWorkers((value) => [...value, ...page.workers]); setWorkerCursor(next); } else setWorkerCursor(undefined); }
+  };
+  return <><div className="view-head"><h1>업무 목록</h1><p>HQ 문맥과 Orca Run/Task/Dispatch를 합성하지 않고 나란히 조회합니다.</p></div>
+    <div className="filters" aria-label="출처 필터">{(["all", "hq", "orca"] as const).map((value) => <button className={filter === value ? "active" : ""} key={value} onClick={() => setFilter(value)}>{value === "all" ? "전체" : value === "hq" ? "HQ" : "Orca"}</button>)}</div>
+    {(filter === "all" || filter === "hq") && <section className="card"><div className="card-head"><h2><SourceBadge source="hq" /> 문맥/요청</h2><span>{contexts.length}건</span></div><div className="table-wrap"><table><thead><tr><th>제목</th><th>상태</th><th>문맥 ID</th><th>갱신</th></tr></thead><tbody>{contexts.map((item) => <tr key={item.contextId} onClick={() => navigate(`/work/hq/${encodeURIComponent(item.contextId)}`)}><td>{item.title}</td><td>{item.state}</td><td className="mono">{item.contextId}</td><td>{new Date(item.updatedAt).toLocaleString()}</td></tr>)}</tbody></table>{contexts.length === 0 ? <p className="empty-copy">HQ 문맥이 없습니다.</p> : null}</div></section>}
+    {(filter === "all" || filter === "orca") && <section className="card section-gap"><div className="card-head"><h2><SourceBadge source="orca" /> Dispatch</h2><span>Run {read.data.runs.runs.length}건 · Dispatch {workers.length}건</span></div><div className="table-wrap"><table><thead><tr><th>Dispatch</th><th>liveness</th><th>Task</th><th>Run</th></tr></thead><tbody>{workers.map((item) => <tr key={item.dispatchId} onClick={() => navigate(`/work/orca/${encodeURIComponent(item.dispatchId)}`)}><td className="mono">{item.dispatchId}</td><td>{item.projection.liveness.verdict}</td><td>{item.projection.taskId}</td><td>{item.projection.runId}</td></tr>)}</tbody></table>{workers.length === 0 ? <p className="empty-copy">Orca Dispatch가 없습니다.</p> : null}</div></section>}
+    {((filter !== "orca" && contextCursor) || (filter !== "hq" && workerCursor)) ? <button className="load-more" onClick={() => void loadMore()}>다음 페이지 읽기</button> : null}
+  </>;
+}
