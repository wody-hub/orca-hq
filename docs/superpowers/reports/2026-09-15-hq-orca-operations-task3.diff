+    <section className="card card-body"><h2><SourceBadge source="hq" /> HQ store</h2>{read.data.hqQuestions.questions.length === 0 ? <p>현재 질문 증거 없음</p> : read.data.hqQuestions.questions.map((item) => <dl className="kv" key={item.requestId}><dt>request</dt><dd>{item.requestId}</dd><dt>observed</dt><dd>{item.evidence.observedAt}</dd><dt>verification</dt><dd>{item.evidence.verification}</dd></dl>)}</section>
