{
  "name": "orca-hq",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "engines": { "node": ">=22.20 <23" },
  "scripts": {
    "build": "pnpm -r build",
    "prepare": "pnpm --filter @orca-hq/core build && pnpm --filter @orca-hq/installer build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:clean": "node scripts/verify-clean-workspace.mjs"
  },
  "dependencies": {
    "@orca-hq/installer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
