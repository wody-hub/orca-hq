{
  "name": "@orca-hq/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "default": "./dist/lifecycle.js"
    },
    "./reconcile": {
      "types": "./dist/reconcile.d.ts",
      "default": "./dist/reconcile.js"
    }
