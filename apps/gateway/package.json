    "@orca-hq/project-registry": "workspace:*",
    "@orca-hq/slack-adapter": "workspace:*",
    "@orca-hq/tailscale-adapter": "workspace:*",
    "@orca-hq/telegram-adapter": "workspace:*",
    "@orca-hq/worker-routing": "workspace:*",
    "fastify": "^5.5.0",
    "zod": "^3.24.2"
