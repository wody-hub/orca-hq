{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@orca-hq/core": ["packages/core/src/index.ts"],
      "@orca-hq/codex-hq": ["packages/codex-hq/src/index.ts"],
      "@orca-hq/orca-adapter": ["packages/orca-adapter/src/index.ts"],
      "@orca-hq/observability": ["packages/observability/src/index.ts"],
      "@orca-hq/persistence": ["packages/persistence/src/index.ts"],
      "@orca-hq/project-registry": ["packages/project-registry/src/index.ts"],
      "@orca-hq/slack-adapter": ["packages/slack-adapter/src/index.ts"],
      "@orca-hq/tailscale-adapter": ["packages/tailscale-adapter/src/index.ts"],
      "@orca-hq/telegram-adapter": ["packages/telegram-adapter/src/index.ts"],
      "@orca-hq/voice": ["packages/voice/src/index.ts"],
      "@orca-hq/worker-routing": ["packages/worker-routing/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "apps/*/test/**/*.ts",
    "vitest.config.ts"
  ]
}
